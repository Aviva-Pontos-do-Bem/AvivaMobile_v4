{
  "expo": {
    "name": "aviva-migration",
    "slug": "aviva-migration",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "aviva",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      }
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "O Aviva usa suas fotos e vídeos para que você possa anexá-los às suas publicações.",
          "videoExportPreset": "MediumQuality"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "O Aviva usa sua localização para marcar onde uma publicação aconteceu, quando você escolher adicioná-la."
        }
      ]
    ],
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    }
  }
}
